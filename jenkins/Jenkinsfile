pipeline {
    agent any

    environment {
      VM_HOST = '192.168.56.104'
      NETWORK_NAME = 'backend-network'
      JAR_PATH = 'authorization-app/target/authorization-app.jar'
      REPOSITORY_URL = 'ssh://root@192.168.56.104/root/git/bck-authorization-svc.git'
      IMAGE_NAME = 'authorization-app'
      IMAGE_TAG = 'latest'
      CONTAINER_NAME = 'authorization-app'
      HOST_PORT = '8082'
      CONTAINER_PORT = '8080'
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'master', description: 'Branch name to build')
    }

    stages {
        stage('Debug') {
            steps {
                echo "Building branch: ${params.BRANCH}"
            }
        }

        stage('Checkout') {
            steps {
                git url: env.REPOSITORY_URL, branch: params.BRANCH
            }
        }

        stage('Credentials') {
            steps {
                withCredentials([
                    file(credentialsId: 'jwt-private-key', variable: 'PRIVATE_KEY_FILE'),
                    file(credentialsId: 'jwt-public-key', variable: 'PUBLIC_KEY_FILE')
                ]) {
                    sh '''
                    mkdir -p authorization-app/src/main/resources/keys

                    cp "$PRIVATE_KEY_FILE" authorization-app/src/main/resources/keys/private-key.pem
                    cp "$PUBLIC_KEY_FILE" authorization-app/src/main/resources/keys/public-key.pem

                    ls -l authorization-app/src/main/resources/keys
                '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x mvnw'
                sh './mvnw -B -DskipTests clean package'
            }
        }

        stage('Verify Artifact') {
            steps {
                sh '''
                    echo "Checking built artifact..."
                    test -f ${JAR_PATH}
                    ls -lh ${JAR_PATH}
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker network inspect ${NETWORK_NAME} > /dev/null 2>&1 || \
                    docker network create ${NETWORK_NAME}
                '''
                sh 'docker rm -f ${CONTAINER_NAME} || true'
                sh '''
                    docker run -d \
                    -p ${HOST_PORT}:${CONTAINER_PORT} \
                    --network ${NETWORK_NAME} \
                    -e AUTH_ISSUER=http://${VM_HOST}:${HOST_PORT} \
                    -e SERVER_PORT=${CONTAINER_PORT} \
                    --name ${CONTAINER_NAME} ${IMAGE_NAME}:${IMAGE_TAG}
                '''
                sh 'docker logs --tail 30 ${CONTAINER_NAME}'
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 10
                    for i in $(seq 1 30); do
                        echo "Attempt $i"
                        docker exec ${CONTAINER_NAME} curl -s http://localhost:${CONTAINER_PORT}/actuator/health | grep '"status":"UP"' && break
                        sleep 1
                    done
                    echo "Health check passed"
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    docker image prune -f
                '''
            }
        }
    }

    post {
        always {
            sh '''
                rm -f authorization-app/src/main/resources/keys/private-key.pem || true
                rm -f authorization-app/src/main/resources/keys/public-key.pem || true
            '''
        }
    }
}